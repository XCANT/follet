{
  "name": "follet",
  "version": "1.5.0",
  "description": "Follet: a Dynamic Island-style notch for Windows in Material You — music, calendar, stats, shelf, clipboard, terminal and AI.",
  "author": "XCANT",
  "license": "MIT",
  "homepage": "https://github.com/XCANT/follet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XCANT/follet.git"
  },
  "bugs": {
    "url": "https://github.com/XCANT/follet/issues"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "check": "node scripts/check.js"
  },
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@material/material-color-utilities": "^0.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "material-symbols": "^0.48.0",
    "node-ical": "^0.27.3"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller": false
  },
  "productName": "Follet",
  "private": true,
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.xcant.follet",
    "productName": "Follet",
    "copyright": "XCANT",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/helper.ps1",
      "node_modules/@lydell/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Follet-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Follet",
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
